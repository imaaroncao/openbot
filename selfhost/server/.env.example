# Self-hosted OpenBot server settings. `scripts/init-secrets.sh` copies this file to `.env`
# (git ignores it) and fills the generated secrets at the bottom. Edit the top part.

# ── Names and address ───────────────────────────────────────────────────────────────────────
# Two DNS A records to the VPS public IPv4. Ports 80/tcp, 443/tcp, 3478/tcp+udp and
# 49160-49200/udp must be open.
API_DOMAIN=api.example.com
SIGNAL_DOMAIN=signal.example.com
TURN_DOMAIN=signal.example.com
TURN_PUBLIC_IP=203.0.113.10
ACME_EMAIL=you@example.com

# ── Email (sign-in codes) ───────────────────────────────────────────────────────────────────
# Any SMTP account with TLS on port 465. Gmail: smtp.gmail.com and an app password.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USERNAME=you@gmail.com
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=you@gmail.com
EMAIL_LICENSE_FROM=

# ── iPhone push notifications (optional) ────────────────────────────────────────────────────
# An APNs auth key (.p8) of your team, from developer.apple.com → Keys. Empty: no push.
APNS_TEAM_ID=HUHQBLKUWS
APNS_TOPIC=com.imaaroncao.openbot
APNS_KEY_ID=
APNS_PRIVATE_KEY=

# ── Fixed for a self-hosted server ──────────────────────────────────────────────────────────
AUTH_EXPOSE_DEVELOPMENT_CODE=false
HOSTED_SERVERS_ENABLED=false
LICENSE_TRIAL_END=2099-01-01T00:00:00Z
GITHUB_APP_CLIENT_ID=

# ── Generated by scripts/init-secrets.sh (keep secret) ──────────────────────────────────────
