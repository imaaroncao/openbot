# Self-hosted OpenBot — your own values. Copy to `selfhost/selfhost.env` (git ignores it) and edit.
# The build scripts in selfhost/desktop and selfhost/ios read this file.

# ── Your servers (selfhost/server on your VPS) ─────────────────────────────────────────────────
# The account service (auth-api) and Signal. Both are baked into the desktop and phone builds as
# defaults. The desktop menu "OpenBot → 自托管服务器…" and the phone sign-in screen can change them.
SELFHOST_AUTH_API_URL=https://api.example.com
SELFHOST_SIGNAL_URL=wss://signal.example.com/v1/signal

# ── Apple developer account ───────────────────────────────────────────────────────────────────
APPLE_TEAM_ID=HUHQBLKUWS
# Developer ID Application identity for the DMG (`security find-identity -v -p codesigning`).
MAC_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# Notarization: the App Store Connect API key below (preferred; it also uploads to TestFlight), or
# a notarytool profile that was stored with `--keychain ~/Library/Keychains/login.keychain-db`.
NOTARY_KEYCHAIN_PROFILE=notarytool-profile
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# ── Identifiers of your builds ────────────────────────────────────────────────────────────────
DESKTOP_BUNDLE_ID=com.imaaroncao.openbot.desktop
# iOS app; the extensions get `<id>.ShareExtension`, `<id>.ExpoWidgetsTarget`,
# `<id>.NotificationService`, and the App Group is `group.<id>`.
IOS_BUNDLE_ID=com.imaaroncao.openbot
IOS_APP_NAME=OpenBot
# iOS signing: `xcode-account` (the Apple ID in Xcode → Settings → Accounts; default when there is
# one) or `api-key` (the App Store Connect key above).
IOS_SIGNING_AUTH=
